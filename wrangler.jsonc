{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "googleforms-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // IP ごとに 60 秒あたり 30 リクエストまで（period は 10 か 60 のみ）
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
